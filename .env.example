# Copy to .env and replace every CHANGE_ME value. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://energy:CHANGE_ME_DB_PASSWORD@db:5432/energy
APP_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
INGEST_API_KEY=CHANGE_ME_GENERATE_A_RANDOM_INGEST_KEY
DEFAULT_TIMEZONE=Africa/Johannesburg
ONLINE_TIMEOUT_SECONDS=10
STALE_TIMEOUT_SECONDS=60
DEMAND_INTERVAL_MINUTES=15
DEMAND_LIMIT_KW=50
TARIFF_ZAR_PER_KWH=3.00
SIMULATOR_ENABLED=true
SIMULATOR_SEED=118
AUTH_SESSION_MINUTES=30
# Keep false for an HTTP-only private LAN. Set true only when the dashboard uses HTTPS.
SESSION_COOKIE_SECURE=false
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=/api/v1/ws/live
