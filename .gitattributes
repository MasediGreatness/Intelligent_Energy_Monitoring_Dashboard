* text=auto

# Keep executable/container sources portable across Windows development and Linux/Pi.
*.sh text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.prettierignore text eol=lf
*.conf text eol=lf
*.example text eol=lf
*.py text eol=lf
*.mako text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf

# Evidence and controlling documents are opaque binary artifacts.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
