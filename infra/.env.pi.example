# Copy to infra/.env.pi, replace every CHANGE_ME value, chmod 600, and never commit it.
# Generate hexadecimal secrets so DB_PASSWORD is safe inside DATABASE_URL.
COMPOSE_PROJECT_NAME=intelligent-energy-dashboard
TARGET_PLATFORM=linux/arm64
IMAGE_TAG=local
# For this repository's GHCR deployment, uncomment both lines.
# API_IMAGE=ghcr.io/masedigreatness/intelligent-energy-dashboard-api
# WEB_IMAGE=ghcr.io/masedigreatness/intelligent-energy-dashboard-web
LAN_BIND_ADDRESS=CHANGE_ME_PRIVATE_LAN_IP
DASHBOARD_PORT=8080
DB_PASSWORD=CHANGE_ME_GENERATE_48_HEX_CHARACTERS
APP_SECRET_KEY=CHANGE_ME_GENERATE_64_HEX_CHARACTERS
INGEST_API_KEY=CHANGE_ME_GENERATE_64_HEX_CHARACTERS
DEFAULT_TIMEZONE=Africa/Johannesburg
ONLINE_TIMEOUT_SECONDS=10
STALE_TIMEOUT_SECONDS=60
DEMAND_INTERVAL_MINUTES=15
DEMAND_LIMIT_KW=50
TARIFF_ZAR_PER_KWH=3.00
SIMULATOR_ENABLED=false
SIMULATOR_SEED=118
AUTH_SESSION_MINUTES=30
# Keep false for the documented private-LAN HTTP deployment. Set true only
# after an HTTPS/TLS endpoint is configured and verified.
SESSION_COOKIE_SECURE=false
